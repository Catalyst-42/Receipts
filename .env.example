# App
APP_NAME=Receipts
DEBUG=true

# Database
DATABASE_URL=postgresql+asyncpg://postgres@localhost:5432/receipts

# Server
HOST=0.0.0.0
PORT=8000

# SSL
SSL_KEYFILE=key.pem
SSL_CERTFILE=cert.pem

# Security
JWT_ALGORITHM=HS256
JWT_SECRET_KEY=insecure-secret-key
JWT_ACCESS_TOKEN_EXPIRE_DAYS=7

# Dadata
DADATA_TOKEN=dadata-token
DADATA_SECRET=dadata-secret
